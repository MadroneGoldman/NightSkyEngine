# This .gitignore is based on Epic's P4IGNORE.
# It is extended for art assets and other code editors such as VS Code
# Use it for Blueprint based projects
# Learn more on how to adjust this file on: https://www.anchorpoint.app/blog/how-to-set-up-a-gitignore-file-for-unreal-engine

#################################
# Unreal Engine generated files #
#################################

# Builds
**/Build/*
**/ArchivedBuilds/*
**/Binaries/*

# Whitelist Binaries folders inside any nested Plugins folder
!**/Plugins/*/Binaries/
!**/Plugins/*/Binaries/**

# Configuration and log files generated by the Editor
**/Saved/*

# Compiled source files for the engine to use
**/Intermediate/*

# Cache files for the editor to use
**/DerivedDataCache/*

# Ignore UBT's configuration.xml
Engine/Programs/UnrealBuildTool/*
*.uatbuildrecord
*.tmp

# Ignore built binaries and temporary build files
*.csprojAssemblyReference.cache
**/obj/*

#######################
# Visual studio files #
########################
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

##################################
# Other code editors and plugins #
##################################
.vscode/
**/.history
*.xcodeproj
*.xcworkspace

# Ignote sentry
**/sentry.properties
**/.sentry-native

# Ignore JetBrain's IDE folders
.idea/
!.idea/runConfigurations
.gradle/

**/net8.0/*

*.vsconfig
*.props

# Ignore Python cached files
*.pyc

######################
# DCC specific files #
######################
*.blend[1-9]*
*.*@*
*.gi
*.gi2
*_bak*.hip
*_bak*.hipnc

# Ignore files added by Finder on Mac
*.DS_Store
#############################
# Fork (MadroneGoldman) extras #
#############################
JonbinsToColData.py

# Final build
WinBuild/*
LinuxBuild/*
AndroidBuild/*

NightSkyEngine.sln.DotSettings.user
NightSkyEngine.uproject.DotSettings.user

Config/DefaultEditorPerProjectUserSettings.ini
*.rar
*.zip

# Non-plugin stuff (plugin-only branch)
/Binaries/*
Config/*
Content/*
docs/*
Platforms/*
Source/*
NightSkyEngine.uproject
LICENSE
README.md

# Prebuilt plugin binaries (NickWTChanges builds its own from modified source)
Plugins/*/Binaries/*

# Shared plugins linked in by WitchTools/Scripts/link_plugins.ps1 (junctions into Documents/Unreal Plugins).
# Git follows junctions, so without these lines it lists every linked file. Remove the links only with
# "link_plugins.ps1 -Unlink" or "cmd /c rmdir"; never rm -rf, Remove-Item -Recurse or git clean -x.
Plugins/NarrativePro/
Plugins/WitchTools/
